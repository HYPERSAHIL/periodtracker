{
  "name": "period-tracker",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "description": "Period Tracker — free, private, local-first period & cycle tracking. Installable PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src api/_worker.js vite.config.ts",
    "format": "prettier --check src api/_worker.js vite.config.ts capacitor.config.ts",
    "selfcheck": "bun scripts/selfcheck.ts",
    "smoke": "bun scripts/smoke.tsx",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name periodtracker",
    "native:sync": "npm run build && cap sync",
    "native:add:android": "cap add android && cap sync android",
    "native:add:ios": "cap add ios && cap sync ios",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/local-notifications": "6.1.3",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "pt-apk-installer": "file:plugins/apk-installer",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
